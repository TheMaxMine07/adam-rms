{% extends "assets/template.twig" %}

{% block content %}
<div class="row">
  <div class="col-lg-6 offset-lg-3 col-md-12" style="padding: 5px;">
      <div class="card card-default">
          <div class="card-body" style="text-align: center;">
                <h3>E-Mail-Adresse bestätigen</h3>
                <p>Wir haben eine Bestätigungs-E-Mail an {{ USERDATA.users_email }} gesendet. Falls du sie nicht findest, prüfe bitte auch den Spam- oder Junk-Ordner. Die Nachricht kommt von {{ fromEmail }}. Über die Schaltfläche kannst du sie erneut senden.</p>
                <button id="submitButton" class="btn btn-default">Bestätigungs-E-Mail erneut senden</button>
                {% if "CONFIG:SET"|serverPermissions %}
                    <a href="{{CONFIG.ROOTURL}}/server/config.php" class="btn btn-default">E-Mail-Bestätigung in den Servereinstellungen deaktivieren</a>
                {% endif %}
          </div>
          <div class="card-footer">
            <a href="{{ CONFIG.LINKS_SUPPORTURL }}">Support kontaktieren</a>
          </div>
          <script>
              $(document).ready(function () {
                  $('#submitButton').click(function () {
                    ajaxcall("account/reSendVerificationEmail.php", {}, function (data) {
                        location.reload();
                    });
                  });
              });
          </script>
      </div>
  </div>
</div>
{% endblock %}
